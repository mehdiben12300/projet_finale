{
  "expo": {
    "name": "MyTasks Pro - Projet Final",
    "slug": "mytasks-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos pour les joindre à vos tâches.",
          "cameraPermission": "L'application a besoin d'accéder à votre caméra pour prendre des photos pour vos tâches."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'application a besoin d'accéder à votre position pour les rappels géolocalisés."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
